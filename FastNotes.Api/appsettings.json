{
  "DatabaseSettings": {
    "DBProvider": "postgresql",
    "ConnectionString": "Host=localhost;Port=5434;Database=fast_notes;Username=postgres;Password=<YourPassword>",
    "ProtectionKeysConnectionString": "Host=localhost;Port=5434;Database=fast_notes;Username=postgres;Password=<YourPassword>"
  },
  "TelegramBot": {
    "Token": "<Your Telegram Bot Token>",
    "WebhookSecretToken": "optional-secret"
  },
  "Jwt": {
    "Issuer": "FastNotes",
    "Audience": "FastNotes.Api",
    "SigningKey": "<your-very-secret-signing-key-32-characters-minimum>",
    "TokenLifetimeMinutes": 60
  },
  "OpenAI": {
    "ApiKey": "<Your OpenAI API Key>",
    "Model": "gpt-4o-mini"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
