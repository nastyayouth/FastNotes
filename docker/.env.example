# Copy this file to docker/.env and replace every placeholder.
POSTGRES_DB=fastnotesdb
POSTGRES_USER=fastnotes
POSTGRES_PASSWORD=replace-with-a-strong-database-password

JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
OPENAI_API_KEY=replace-with-your-openai-api-key

# The host port exposed by the UI container.
FASTNOTES_PORT=3000